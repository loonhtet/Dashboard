generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                   String    @id @default(uuid())
  name                 String?   @db.VarChar
  password             String?   @db.VarChar
  email                String?   @unique @db.VarChar
  email_verified       Boolean?  @default(false)
  verification_token   String?   @db.VarChar
  verification_expires DateTime? @db.Timestamp(6)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
}

model bookings {
  id            String    @id @default(uuid())
  full_name     String    @db.VarChar
  email_address String    @db.VarChar
  phone_number  String    @db.VarChar
  service       String    @db.VarChar
  note          String?   @db.Text
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model blogs {
  id         String     @id @default(uuid())
  title      String
  slug       String     @unique
  content    String
  published  Boolean    @default(false)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  categoryId String
  category   categories @relation(fields: [categoryId], references: [id])
}

model gallery {
  id          String    @id @default(uuid())
  image_url   String    @db.VarChar
  title       String
  serviceId   String    
  service     services  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
}

model services {
  id          String     @id @default(uuid())
  title       String     @db.VarChar
  description String?    @db.Text
  slug        String     @unique
  gallery     gallery[]  

  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
}

model categories {
  id         String   @id @default(uuid())
  name       String   @unique
  slug       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  blogs      blogs[]
}

model audit_logs {
  id          String            @id @default(uuid())
  user_name   String            @db.VarChar
  user_email  String            @db.VarChar
  action_type action_type_enum?
  target_type String?           @db.VarChar
  target_id   String?           @db.Uuid
  description String?
  timestamp   DateTime?         @default(now()) @db.Timestamp(6)
}

model user_otps {
  id         String    @id @default(uuid())
  user_email String    @db.VarChar
  otp_code   String    @db.VarChar
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([user_email], map: "idx_user_otps_user_email")
}

enum action_type_enum {
  CREATE
  UPDATE
  DELETE
}
